# ==============================================================================
# Configuration du scraper et service HTTP Ohm Énergie
# ==============================================================================

# Identifiant de connexion : adresse e-mail OU référence client (CM-...)
OHM_LOGIN=

# Mot de passe de l'espace client.
#
# Attention à python-dotenv, qui interprète les guillemets et le signe $ :
# - mot de passe contenant un guillemet double : l'entourer de guillemets doubles
#   et échapper le guillemet :   OHM_PASSWORD="abc\"def"
# - la séquence ${...} déclenche une interpolation. Un $ seul est sans effet ;
#   en cas de doute, utiliser des guillemets simples (sans interpolation),
#   sauf si le mot de passe contient lui-même une apostrophe.
OHM_PASSWORD=

# Optionnels : déduits de la réponse de /login s'ils sont absents.
# Numéro client (routes user/{number}/...)
# OHM_CUSTOMER_NUMBER=
# Numéro de contrat sélectionné (paramètre {ct})
# OHM_CT=

# ------------------------------------------------------------------------------
# Service HTTP & Conteneurisation
# ------------------------------------------------------------------------------

# Adresse d'écoute du serveur HTTP interne (défaut : 127.0.0.1 en local, 0.0.0.0 dans Docker)
SERVICE_HOST=127.0.0.1

# Port d'écoute du serveur HTTP (défaut : 8080)
SERVICE_PORT=8080

# Interface hôte sur laquelle Docker Compose publie le port du service (défaut : 127.0.0.1)
# Restreindre à 127.0.0.1 évite d'exposer publiquement le service sur le réseau local ou public.
OHM_PUBLISH_ADDRESS=127.0.0.1

# Jeton secret Bearer (optionnel).
# Si cette valeur est définie, toutes les requêtes (sauf /health) devront inclure
# l'en-tête HTTP : Authorization: Bearer <votre_jeton>
# Fortement recommandé si le service est exposé en dehors de localhost.
OHM_API_TOKEN=

# Durée de vie du cache en mémoire en secondes (défaut : 900, soit 15 minutes).
# Évite de surcharger l'espace client Ohm Énergie lors de requêtes répétées.
OHM_CACHE_TTL=900
