# Identifiant de connexion : adresse e-mail OU référence client (CM-...)
OHM_LOGIN=

# Mot de passe de l'espace client.
#
# Attention à python-dotenv, qui interprète les guillemets et le signe $ :
# - mot de passe contenant un guillemet double : l'entourer de guillemets doubles
#   et échapper le guillemet :   OHM_PASSWORD="abc\"def"
# - la séquence ${...} déclenche une interpolation. Un $ seul est sans effet ;
#   en cas de doute, utiliser des guillemets simples (sans interpolation),
#   sauf si le mot de passe contient lui-même une apostrophe.
OHM_PASSWORD=

# Optionnels : déduits de la réponse de /login s'ils sont absents.
# Numéro client (routes user/{number}/...)
# OHM_CUSTOMER_NUMBER=
# Numéro de contrat sélectionné (paramètre {ct})
# OHM_CT=
