meta {
  name: getLegacyConsumption (granularité power-months, format JSON) - Séries de consommation (legacy)
  type: http
  seq: 11
}

get {
  url: {{host}}:{{port}}/consumption
  body: none
  auth: bearer
}

params:query {
  granularity: power-months
  from: 2026-10-18
  to: 2026-10-24
  format: json
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  Route historique, conservée à l'identique. Retourne une série de consommation pour `granularity` = `hourly`, `daily`, `power-days` ou `power-months`.
  Paramètres : `from`, `to`, `format` (`json` ou `csv`) et `refresh`. Remplacée par les routes /v1.

  Variante : granularité power-months, format JSON.
}
