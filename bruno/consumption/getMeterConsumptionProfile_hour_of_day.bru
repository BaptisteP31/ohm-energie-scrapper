meta {
  name: getMeterConsumptionProfile (par hour-of-day) - Calculer le profil moyen de consommation
  type: http
  seq: 12
}

get {
  url: {{host}}:{{port}}/v1/meters/{{meterId}}/consumption/profile
  body: none
  auth: bearer
}

params:query {
  by: hour-of-day
  from: 2026-10-18
  to: 2026-10-24
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta: isDefined
  res.body.by: isDefined
  res.body.from: isDefined
  res.body.to: isDefined
  res.body.items: isDefined
  res.body.items: isArray
}

docs {
  Calcule la consommation moyenne par heure de la journée (`hour-of-day`) ou par jour de la semaine (`day-of-week`), sur la plage demandée.
  La plage est limitée à 31 jours.

  Variante : par hour-of-day.
}
